# College Fest Registration Desk

import os
import re

def validate_email(email):
    pattern = r"^[\w.-]+@[\w.-]+\.\w+$"
    return re.match(pattern, email) is not None


def read_registrations(files):
    registrations = {}
    errors = []

    for filename in files:
        try:
            with open(filename, "r", encoding="utf-8") as f:
                for line_no, line in enumerate(f, 1):
                    try:
                        parts = line.strip().split(",")

                        if len(parts) != 5:
                            raise ValueError("Invalid fields")

                        reg, name, dept, email, events = [
                            x.strip() for x in parts
                        ]

                        if not validate_email(email):
                            raise ValueError("Invalid email")

                        if reg in registrations:
                            continue

                        registrations[reg] = {
                            "name": name,
                            "department": dept,
                            "email": email,
                            "events": events.split(";")
                        }

                    except ValueError as e:
                        errors.append(
                            f"{filename}, Line {line_no}: {e}"
                        )

        except FileNotFoundError:
            errors.append(f"Missing file: {filename}")

    return registrations, errors


def generate_reports(registrations, errors):
    with open("master_list.txt", "w", encoding="utf-8") as f:
        for reg, data in registrations.items():
            f.write(
                f"{reg},{data['name']},{data['department']},"
                f"{data['email']},{';'.join(data['events'])}\n"
            )

    event_lists = {}

    for reg, data in registrations.items():
        for event in data["events"]:
            event_lists.setdefault(event, []).append(
                f"{reg},{data['name']}"
            )

    for event, participants in event_lists.items():
        with open(
            f"{event}.txt", "w", encoding="utf-8"
        ) as f:
            f.write("\n".join(participants))

    with open("summary.txt", "w", encoding="utf-8") as f:
        f.write(f"Total registrations: {len(registrations)}\n")
        f.write(f"Total participants: {sum(len(d['events']) for d in registrations.values())}\n")

    with open("error_log.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(errors))


