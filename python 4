# TASK 2 – ATTENDANCE REPORT
import os

def attendance_report(folder):
    attendance = {}
    errors = []

    files = os.listdir(folder)

    for filename in files:
        if filename.endswith(".txt"):
            path = os.path.join(folder, filename)

            with open(path, "r", encoding="utf-8") as f:
                for line_no, line in enumerate(f, 1):
                    parts = line.strip().split(",")

                    try:
                        if len(parts) != 3:
                            raise ValueError

                        reg, date, status = parts

                        if status not in ("P", "A"):
                            raise ValueError

                        if reg not in attendance:
                            attendance[reg] = [0, 0]

                        if status == "P":
                            attendance[reg][0] += 1
                        else:
                            attendance[reg][1] += 1

                    except ValueError:
                        errors.append(
                            f"{filename}, Line {line_no}: {line.strip()}"
                        )

    with open("attendance_report.txt", "w", encoding="utf-8") as f:
        for reg, count in attendance.items():
            total = count[0] + count[1]
            percentage = count[0] / total * 100

            f.write(f"{reg}: {percentage:.2f}%\n")

            if percentage < 75:
                f.write("Below 75% attendance\n")

    with open("error_log.txt", "a", encoding="utf-8") as f:
        for error in errors:
            f.write(error + "\n")


# TASK 3 – ERROR HANDLING
class InvalidRecord(Exception):
    pass


def parse_line(line):
    parts = line.strip().split(",")

    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}"
        )

    if parts[2] not in ("P", "A"):
        raise InvalidRecord(f"invalid status {parts[2]!r}")

    return tuple(parts)


def summarise(path):
    present, absent, errors = 0, 0, []

    try:
        with open(path, "r", encoding="utf-8") as f:
            for line_no, line in enumerate(f, 1):
                try:
                    reg, date, status = parse_line(line)

                    if status == "P":
                        present += 1
                    else:
                        absent += 1

                except InvalidRecord as e:
                    errors.append((line_no, str(e)))

    except (FileNotFoundError, PermissionError,
            UnicodeDecodeError, OSError) as e:
        raise RuntimeError("File processing failed") from e

    else:
        print("File processed successfully")

    finally:
        print("File processing completed")

    return present, absent, errors


